# The user's personal data: never versioned
data/*.json
data/cvs/*.json
# The app's access key (cv_generator/app/access_key.py) and the file it is written through
data/access.key
data/.access.key.*
output/*.pdf
assets/foto.*
assets/photo.*
# Backups of the user data taken before a format migration
data/backup-*/
# Reflex keeps the files uploaded from the interface here:
# the LinkedIn PDF carries the user's whole CV.
uploaded_files/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Reflex
.states
.web
assets/external/
reflex.log
*.db

# Playwright verification screenshots
.playwright-mcp/

# Local work notes and tool state (design reviews, specs and plans from building it).
# The design review screenshots show the app with the real profile loaded.
.impeccable/
.superpowers/
.claude/
docs/superpowers/

# macOS
.DS_Store

# The launcher's log of the latest run
start.log
